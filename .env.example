# Project Zomboid Server Manager - Configuration
# This file will be automatically created by setup-new-server.sh
# You can also manually copy this file to .env and customize your settings

# Server Configuration
SERVER_NAME="My PZ Server"
SERVER_DESCRIPTION="A Project Zomboid Dedicated Server - Welcome Survivors!"
ADMIN_PASSWORD="changeme123"
MAX_PLAYERS=32

# Installation Directory
INSTALL_DIR="$HOME/pzserver"
STEAMCMD_DIR="$INSTALL_DIR/steamcmd"

# Ports
# Note: UDP_PORT and STEAM_PORT2 are automatically calculated (+1 from base ports)
DEFAULT_PORT=16261
UDP_PORT=16262
STEAM_PORT1=8766
STEAM_PORT2=8767
RCON_PORT=27015

# Network (optional - for status display)
# Leave empty if not using
PUBLIC_DOMAIN=""
PUBLIC_IPV6=""
PLAYIT_TUNNEL=""

# Playit.gg Configuration
PLAYIT_ENABLED=true
